<Window x:Class="L2Monitor.Tray.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:ClassModifier="internal"
        Title="Aden+"
        Icon="../Assets/AdenPlus.ico"
        Width="760"
        Height="720"
        MinWidth="760"
        MaxWidth="760"
        MinHeight="720"
        MaxHeight="720"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#20242B">
    <Window.Resources>
        <SolidColorBrush x:Key="CardBrush" Color="#2A3038" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#3B4654" />
        <SolidColorBrush x:Key="AccentBrush" Color="#2F6FED" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#427EF0" />
        <SolidColorBrush x:Key="AccentPressedBrush" Color="#2458C8" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#344765" />
        <SolidColorBrush x:Key="TextBrush" Color="#E7ECF2" />
        <SolidColorBrush x:Key="MutedBrush" Color="#AEB8C5" />
        <SolidColorBrush x:Key="InputBrush" Color="#242A31" />
        <SolidColorBrush x:Key="PanelBrush" Color="#303946" />
        <SolidColorBrush x:Key="InputBorderBrush" Color="#455263" />
        <SolidColorBrush x:Key="ScrollThumbBrush" Color="#617084" />
        <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#8494A8" />
        <SolidColorBrush x:Key="ScrollTrackBrush" Color="#1B2027" />
        <SolidColorBrush x:Key="ToolTipBackgroundBrush" Color="#151A20" />
        <SolidColorBrush x:Key="ToolTipForegroundBrush" Color="#F1F5F9" />
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#242A31" />
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#E7ECF2" />
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#2A3038" />
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#E7ECF2" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#2F6FED" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF" />

        <Style TargetType="Border" x:Key="CardStyle">
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="ButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10">
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="KeyboardFocusBorder"
                                    Margin="-2"
                                    BorderBrush="#A9C5FF"
                                    BorderThickness="2"
                                    CornerRadius="12"
                                    IsHitTestVisible="False"
                                    Opacity="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource AccentPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="KeyboardFocusBorder" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#3A4350" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#4B5665" />
                                <Setter Property="Foreground" Value="#8E99A8" />
                                <Setter Property="Cursor" Value="Arrow" />
                                <Setter TargetName="KeyboardFocusBorder" Property="Opacity" Value="0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Background" Value="{StaticResource InputBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Background" Value="{StaticResource InputBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <ControlTemplate x:Key="DarkComboBoxToggleTemplate" TargetType="ToggleButton">
            <Border x:Name="ToggleBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4">
                <Grid>
                    <ContentPresenter Margin="10,0,32,0"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Left"
                                      RecognizesAccessKey="True" />
                    <Path HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          Margin="0,0,12,0"
                          Fill="{StaticResource MutedBrush}"
                          Data="M 0 0 L 8 0 L 4 5 Z" />
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="DarkComboBoxTemplate" TargetType="ComboBox">
            <Grid>
                <ToggleButton x:Name="ToggleButton"
                              Template="{StaticResource DarkComboBoxToggleTemplate}"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              Foreground="{TemplateBinding Foreground}"
                              Focusable="False"
                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                              ClickMode="Press">
                    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Left" />
                </ToggleButton>
                <Popup x:Name="Popup"
                       AllowsTransparency="True"
                       Placement="Bottom"
                       IsOpen="{TemplateBinding IsDropDownOpen}"
                       PopupAnimation="Fade">
                    <Border x:Name="PopupBorder"
                            MinWidth="{Binding ActualWidth, ElementName=ToggleButton}"
                            Margin="0,4,0,0"
                            Padding="3"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource InputBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <ScrollViewer MaxHeight="260" CanContentScroll="True" Background="{StaticResource PanelBrush}">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
        </ControlTemplate>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Background" Value="{StaticResource InputBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template" Value="{StaticResource DarkComboBoxTemplate}" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Padding" Value="10,7" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="3">
                                        <ContentPresenter Margin="4,0" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentBrush}" />
                                            <Setter Property="Foreground" Value="White" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.55" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HoverToolTipStyle" TargetType="ToolTip">
            <Setter Property="Background" Value="{StaticResource ToolTipBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource ToolTipForegroundBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="MaxWidth" Value="440" />
            <Setter Property="Placement" Value="Bottom" />
            <Setter Property="HasDropShadow" Value="True" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="420" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HelpButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="MinWidth" Value="24" />
            <Setter Property="MinHeight" Value="20" />
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Help" />
            <Setter Property="Content" Value="(?)" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="250" />
            <Setter Property="ToolTipService.ShowDuration" Value="12000" />
            <Setter Property="ToolTipService.Placement" Value="Bottom" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="IsTabStop" Value="True" />
            <Setter Property="AutomationProperties.Name" Value="Справка" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="HelpBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Foreground" Value="#A9C5FF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="HelpBorder" Property="BorderBrush" Value="#A9C5FF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#7F8996" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DeliveryModeRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,16,0" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="18" Height="18" Margin="0,0,7,0" VerticalAlignment="Center">
                                <Ellipse x:Name="Outer" Fill="{StaticResource InputBrush}" Stroke="{StaticResource InputBorderBrush}" StrokeThickness="1.5" />
                                <Ellipse x:Name="Inner" Width="8" Height="8" Fill="{StaticResource AccentBrush}" Visibility="Collapsed" />
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Outer" Property="Stroke" Value="{StaticResource AccentBrush}" /></Trigger>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Outer" Property="Stroke" Value="{StaticResource AccentBrush}" /><Setter TargetName="Inner" Property="Visibility" Value="Visible" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Outer" Property="Stroke" Value="#A9C5FF" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource MutedBrush}" /><Setter Property="Cursor" Value="Arrow" /><Setter TargetName="Outer" Property="Opacity" Value="0.55" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollBarThumbStyle" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder"
                                Margin="2"
                                Background="{StaticResource ScrollThumbBrush}"
                                CornerRadius="6" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource ScrollThumbHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="VerticalScrollBarTemplate" TargetType="ScrollBar">
            <Border Width="{TemplateBinding Width}"
                    Background="{StaticResource ScrollTrackBrush}"
                    CornerRadius="7"
                    SnapsToDevicePixels="True">
                <Track x:Name="PART_Track"
                       IsDirectionReversed="True"
                       Focusable="False">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Style="{x:Null}" Background="Transparent" BorderThickness="0" Focusable="False" IsTabStop="False" />
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource ScrollBarThumbStyle}" MinHeight="36" />
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Style="{x:Null}" Background="Transparent" BorderThickness="0" Focusable="False" IsTabStop="False" />
                    </Track.IncreaseRepeatButton>
                </Track>
            </Border>
        </ControlTemplate>

        <ControlTemplate x:Key="HorizontalScrollBarTemplate" TargetType="ScrollBar">
            <Border Height="{TemplateBinding Height}"
                    Background="{StaticResource ScrollTrackBrush}"
                    CornerRadius="7"
                    SnapsToDevicePixels="True">
                <Track x:Name="PART_Track"
                       Focusable="False">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Style="{x:Null}" Background="Transparent" BorderThickness="0" Focusable="False" IsTabStop="False" />
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource ScrollBarThumbStyle}" MinWidth="36" />
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Style="{x:Null}" Background="Transparent" BorderThickness="0" Focusable="False" IsTabStop="False" />
                    </Track.IncreaseRepeatButton>
                </Track>
            </Border>
        </ControlTemplate>

        <Style TargetType="ScrollBar">
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="14" />
                    <Setter Property="Template" Value="{StaticResource HorizontalScrollBarTemplate}" />
                </Trigger>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="14" />
                    <Setter Property="Template" Value="{StaticResource VerticalScrollBarTemplate}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Margin="0,0,0,12" Padding="8" Background="#252C35" CornerRadius="16">
                                <TabPanel IsItemsHost="True" Margin="0,0,6,0" Background="Transparent" KeyboardNavigation.TabIndex="1" />
                            </Border>
                            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="MinWidth" Value="118" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="#303946" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="BorderBrush" Value="#465466" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Margin="0,0,6,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#55729C" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsSelected" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListView">
            <Setter Property="Background" Value="{StaticResource InputBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="ListViewItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="#303946" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
            <Setter Property="Padding" Value="8,6" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,12" Background="#303741">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock x:Name="HeadlineText" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Text="Подключение к агенту..." />
                    <TextBlock x:Name="DetailText" Margin="0,6,0,0" FontSize="13" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Text="Ожидаю локальный агент." />
                    <TextBlock x:Name="EndpointText" Margin="0,10,0,0" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Text="Адрес: н/д" />
                </StackPanel>

                <WrapPanel Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Border x:Name="ModeBadgeBorder" Margin="0,0,8,8" Padding="10,6" CornerRadius="999" Background="#343E4A">
                        <TextBlock x:Name="ModeBadgeText" FontSize="12" FontWeight="SemiBold" Foreground="#E7ECF2" Text="Режим неизвестен" />
                    </Border>
                    <Border x:Name="AgentBadgeBorder" Margin="0,0,8,8" Padding="10,6" CornerRadius="999" Background="#343E4A">
                        <TextBlock x:Name="AgentBadgeText" FontSize="12" FontWeight="SemiBold" Foreground="#E7ECF2" Text="Агент недоступен" />
                    </Border>
                    <Border x:Name="DeliveryBadgeBorder" Margin="0,0,8,8" Padding="10,6" CornerRadius="999" Background="#343E4A">
                        <TextBlock x:Name="DeliveryBadgeText" FontSize="12" FontWeight="SemiBold" Foreground="#E7ECF2" Text="Доставка неизвестна" />
                    </Border>
                </WrapPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1">
            <TabItem Header="Сводка">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Margin="0,0,0,14" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="Состояние агента" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,16,12">
                                        <TextBlock Foreground="{StaticResource MutedBrush}" Text="Режим" />
                                        <TextBlock x:Name="ModeValueText" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,12">
                                        <TextBlock Foreground="{StaticResource MutedBrush}" Text="Статус агента" />
                                        <TextBlock x:Name="AgentStatusValueText" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,12">
                                        <TextBlock Foreground="{StaticResource MutedBrush}" Text="Клиенты и пробы" />
                                        <TextBlock x:Name="ConnectionCountValueText" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,16,12">
                                        <TextBlock Foreground="{StaticResource MutedBrush}" Text="Доставка" />
                                        <TextBlock x:Name="DeliveryHealthValueText" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="3" Grid.ColumnSpan="2">
                                        <TextBlock Foreground="{StaticResource MutedBrush}" Text="Последний инцидент" />
                                        <TextBlock x:Name="LastIncidentValueText" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Margin="0,0,0,14" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="Быстрые действия" />
                                <primitives:UniformGrid Columns="2">
                                    <Button x:Name="RefreshButton" Content="Обновить" />
                                    <Button x:Name="ReloadButton" Content="Перечитать конфиг" />
                                    <Button x:Name="RestartButton" Content="Перезапустить агент" />
                                </primitives:UniformGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="SettingsTab" Header="Настройки">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border x:Name="SettingsCard" Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <TextBlock DockPanel.Dock="Left" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="Настройки" />
                                    <Button x:Name="SaveSettingsButton" DockPanel.Dock="Right" Margin="12,0,0,0" Padding="16,9" Content="Сохранить настройки" />
                                </DockPanel>
                                <TextBlock x:Name="SettingsDirtyText" Foreground="{StaticResource MutedBrush}" Text="Несохранённых изменений нет." TextWrapping="Wrap" />
                                <CheckBox x:Name="AutostartInput"
                                          Margin="0,14,0,0"
                                          FontWeight="SemiBold"
                                          Foreground="{StaticResource TextBrush}"
                                          Content="Запускать Aden+ вместе с Windows" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="NotificationTemplatesCard" Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Margin="0,0,0,14" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="Тексты уведомлений и исключения" />

                                <DockPanel>
                                    <TextBlock Foreground="{StaticResource MutedBrush}" Text="Не отслеживать окна по заголовку" />
                                    <Button x:Name="IgnoredWindowsHelpButton" Style="{StaticResource HelpButtonStyle}">
                                        <Button.ToolTip><ToolTip Style="{StaticResource HoverToolTipStyle}" Content="Каждая строка — отдельный фильтр. Если заголовок окна содержит эту фразу, уведомления по такому окну не отправляются." /></Button.ToolTip>
                                    </Button>
                                </DockPanel>
                                <TextBox x:Name="IgnoredWindowTitlesInput" AcceptsReturn="True" Height="96" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />

                                <DockPanel>
                                    <TextBlock Foreground="{StaticResource MutedBrush}" Text="Текст уведомления о дисконнекте" />
                                    <Button x:Name="DisconnectTemplateHelpButton" Style="{StaticResource HelpButtonStyle}">
                                        <Button.ToolTip><ToolTip Style="{StaticResource HoverToolTipStyle}" Content="Каждая непустая строка — отдельный вариант. Доступны подстановки: {pid}, {name}, {event}, {durationSec}, {windowTitle}." /></Button.ToolTip>
                                    </Button>
                                </DockPanel>
                                <CheckBox x:Name="DisconnectNotificationEnabledInput" Margin="0,6,0,8" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Content="Отправлять уведомления о дисконнекте" IsChecked="True" />
                                <TextBox x:Name="GhostDisconnectMessageTemplateInput" AcceptsReturn="True" Height="72" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />

                                <DockPanel>
                                    <TextBlock Foreground="{StaticResource MutedBrush}" Text="Текст уведомления о закрытии клиента" />
                                    <Button x:Name="ProcessExitedTemplateHelpButton" Style="{StaticResource HelpButtonStyle}">
                                        <Button.ToolTip><ToolTip Style="{StaticResource HoverToolTipStyle}" Content="Можно задать несколько вариантов по одному на строку и использовать те же подстановки." /></Button.ToolTip>
                                    </Button>
                                </DockPanel>
                                <CheckBox x:Name="ProcessExitedNotificationEnabledInput" Margin="0,6,0,8" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Content="Отправлять уведомления о закрытии клиента" IsChecked="True" />
                                <TextBox x:Name="ProcessExitedMessageTemplateInput" AcceptsReturn="True" Height="72" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                                <DockPanel>
                                    <TextBlock Foreground="{StaticResource MutedBrush}" Text="Текст уведомления о смерти" />
                                    <Button x:Name="DeadStartedTemplateHelpButton" Style="{StaticResource HelpButtonStyle}">
                                        <Button.ToolTip><ToolTip Style="{StaticResource HoverToolTipStyle}" Content="Можно задать несколько вариантов по одному на строку. Доступны подстановки: {pid}, {name}, {event}, {durationSec}, {windowTitle}." /></Button.ToolTip>
                                    </Button>
                                </DockPanel>
                                <CheckBox x:Name="DeadStartedNotificationEnabledInput" Margin="0,6,0,8" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Content="Отправлять уведомления о смерти" IsChecked="True" />
                                <TextBox x:Name="DeadStartedMessageTemplateInput" AcceptsReturn="True" Height="72" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="DeliveryCard" Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Margin="0,0,0,14" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="Доставка уведомлений" />
                                <CheckBox x:Name="DeliveryEnabledInput" Margin="0,0,0,12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Content="Включить доставку уведомлений" />

                                <StackPanel x:Name="DeliveryConfigPanel">
                                    <TextBlock Foreground="{StaticResource MutedBrush}" Text="Куда отправлять уведомления" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <RadioButton x:Name="TelegramDeliveryModeRadio" GroupName="DeliveryMode" Style="{StaticResource DeliveryModeRadioButtonStyle}" Content="Telegram" IsChecked="True" />
                                        <RadioButton x:Name="CloudDeliveryModeRadio" GroupName="DeliveryMode" Style="{StaticResource DeliveryModeRadioButtonStyle}" Content="Облако" />
                                    </StackPanel>
                                    <Button x:Name="TestNotificationButton" Width="250" HorizontalAlignment="Left" Margin="0,0,0,10" Content="Отправить тестовое сообщение" />

                                    <StackPanel x:Name="LocalDeliveryPanel" Visibility="Collapsed">
                                        <TextBlock Margin="0,0,0,4" Foreground="{StaticResource MutedBrush}" Text="Чат для уведомлений" />
                                        <Border x:Name="TelegramChatBindingBorder" Margin="0,0,0,12" Padding="10,8" CornerRadius="10" Background="#343E4A" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1">
                                            <TextBlock x:Name="TelegramChatBindingText" Foreground="{StaticResource TextBrush}" Text="Чат для уведомлений не привязан" />
                                        </Border>

                                        <TextBlock Margin="0,0,0,4" Foreground="{StaticResource MutedBrush}" Text="Состояние токена Telegram" />
                                        <Border x:Name="TelegramSecretStatusBorder" Margin="0,0,0,12" Padding="10,8" CornerRadius="10" Background="#343E4A" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1">
                                            <TextBlock x:Name="TelegramSecretStatusText" Foreground="{StaticResource TextBrush}" Text="Неизвестно" />
                                        </Border>

                                        <TextBlock Margin="0,0,0,4" Foreground="{StaticResource MutedBrush}" Text="Новый токен Telegram" />
                                        <PasswordBox x:Name="TelegramSecretInput" />

                                        <TextBlock Margin="0,0,0,4" Foreground="{StaticResource MutedBrush}" Text="Код для привязки" />
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="TelegramLinkCodeText"
                                                     Grid.Column="0"
                                                     Margin="0,0,8,0"
                                                     Padding="10,8"
                                                     Height="44"
                                                     FontSize="18"
                                                     FontWeight="SemiBold"
                                                     Foreground="{StaticResource TextBrush}"
                                                     Background="#242A31"
                                                     BorderBrush="{StaticResource InputBorderBrush}"
                                                     BorderThickness="1"
                                                     IsReadOnly="True"
                                                     IsReadOnlyCaretVisible="False"
                                                     VerticalContentAlignment="Center"
                                                     Text="Сначала нажмите «Получить код»." />
                                            <Button x:Name="CopyTelegramLinkCodeButton"
                                                    Grid.Column="1"
                                                    Width="44"
                                                    Height="44"
                                                    Margin="0"
                                                    Padding="0"
                                                    Content="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="16">
                                                <Button.ToolTip>
                                                    <ToolTip Style="{StaticResource HoverToolTipStyle}" Content="Копировать код" />
                                                </Button.ToolTip>
                                            </Button>
                                        </Grid>

                                        <TextBlock x:Name="TelegramLinkHintText" Margin="0,0,0,10" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Text="Сначала получите код, отправьте его боту в личном чате, потом нажмите «Подтвердить привязку»." />

                                        <WrapPanel>
                                            <Button x:Name="BindTelegramChatButton" Width="220" HorizontalAlignment="Left" Content="Получить код" />
                                            <Button x:Name="ConfirmTelegramLinkButton" Width="220" HorizontalAlignment="Left" Content="Подтвердить привязку" />
                                            <Button x:Name="SaveTelegramSecretButton" Width="230" HorizontalAlignment="Left" Content="Обновить токен Telegram" />
                                        </WrapPanel>
                                    </StackPanel>

                                    <StackPanel x:Name="CloudDeliveryPanel" Visibility="Collapsed">
                                        <TextBlock Margin="0,0,0,4" Foreground="{StaticResource MutedBrush}" Text="Состояние ключа облака" />
                                        <Border x:Name="CloudSecretStatusBorder" Margin="0,0,0,12" Padding="10,8" CornerRadius="10" Background="#343E4A" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1">
                                            <TextBlock x:Name="CloudSecretStatusText" Foreground="{StaticResource TextBrush}" Text="Неизвестно" />
                                        </Border>
                                        <DockPanel>
                                            <TextBlock Margin="0,0,0,4" Foreground="{StaticResource MutedBrush}" Text="Новый ключ облака" />
                                            <Button x:Name="CloudKeyHelpButton" Style="{StaticResource HelpButtonStyle}">
                                                <Button.ToolTip><ToolTip Style="{StaticResource HoverToolTipStyle}" Content="Ключ используется для подключения к облачному сервису." /></Button.ToolTip>
                                            </Button>
                                        </DockPanel>
                                        <PasswordBox x:Name="CloudSecretInput" />
                                        <Button x:Name="SaveCloudSecretButton" Width="190" HorizontalAlignment="Left" Content="Обновить ключ облака" />
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock x:Name="DeliveryDisabledHintText" Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Text="Когда доставка выключена, агент продолжает мониторинг, но не отправляет уведомления." />
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Активность">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Margin="0,0,0,12" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="Активные L2-соединения" />
                            <ListView x:Name="ConnectionsList">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Окно" Width="266" DisplayMemberBinding="{Binding WindowTitle}" />
                                        <GridViewColumn Header="Состояние" Width="128" DisplayMemberBinding="{Binding State}" />
                                        <GridViewColumn Header="Когда" Width="150" DisplayMemberBinding="{Binding ObservedAt}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Margin="0,0,0,12" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="Последние инциденты" />
                            <ListView x:Name="IncidentsList">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Тип" Width="144" DisplayMemberBinding="{Binding Kind}" />
                                        <GridViewColumn Header="Описание" Width="316" DisplayMemberBinding="{Binding Summary}" />
                                        <GridViewColumn Header="Когда" Width="146" DisplayMemberBinding="{Binding OccurredAt}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,12,0,0" Padding="12,10" Background="#252C35">
            <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}" Text="Готово." TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
